# Required: choose your own long password. Never commit secrets.
OSINTALPHA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
OSINTALPHA_DB_PATH=./instance/osintalpha.db
# Optional: set to 1 behind HTTPS in production
OSINTALPHA_SECURE_COOKIE=0
# Optional Grok API: server-side only; case owner must consent to sending evidence
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional GroqCloud API: do not use an xAI key here.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Optional TfL API key. Obtain from the official TfL developer portal.
TFL_APP_KEY=

# Brave Search: web discovery and optional Groq LLM Context, private backend only
BRAVE_SEARCH_API_KEY=
# Search currency and jurisdiction are explicitly chosen per case (defaults: any time, US/en).
# Groq and Brave live calls consume provider quota; budget and validate externally.
# Default tested/mock model configuration (live provider contract not certified)
# Optional city-only Nominatim usage complies with OSM attribution/rate policy.
# Do not store API credentials, session tokens or private research cases in git.

# Release 8.1.0: optional constrained model capability matrix (see app/release.py)
# GROQ_MODEL may be openai/gpt-oss-120b or openai/gpt-oss-20b; verify live vendor catalogue separately.
# BRAVE_SEARCH_API_KEY: private web search subscription; check quota, license and data rights.
# GROQ_API_KEY: private inference subscription; opt-in per case, not for public frontend.
# XAI_API_KEY: separate optional provider account; do not substitute a Groq key.
# Never print or commit API keys. Production requires encrypted backups and verified restore.
