# Required: choose your own long password. Never commit secrets.
OSINTALPHA_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
OSINTALPHA_DB_PATH=./instance/osintalpha.db
# Optional: set to 1 behind HTTPS in production
OSINTALPHA_SECURE_COOKIE=0
# Optional Grok API: server-side only; case owner must consent to sending evidence
XAI_API_KEY=
XAI_MODEL=grok-4.7
# Optional TfL API key. Obtain from the official TfL developer portal.
TFL_APP_KEY=
